# Server
PORT=4000
NODE_ENV=development
API_PREFIX=/api/v1

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=chanda_hr
DB_CONNECTION_LIMIT=10

# TLS — required by managed MySQL (Aiven, PlanetScale, RDS). Leave false locally.
# DB_SSL_CA is the provider's CA certificate as PEM; without it the connection
# is encrypted but unverified.
DB_SSL=false
DB_SSL_CA=

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_EXPIRES_IN_DAYS=30

# Demo password used by the seeder for every employee
SEED_PASSWORD=demo@1234
