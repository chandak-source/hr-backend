# Server
PORT=4000
NODE_ENV=development
API_PREFIX=/api/v1

# MongoDB — Atlas connection string (database name goes in the path)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hrmh?retryWrites=true&w=majority
# Optional: override the database from the URI path
MONGODB_DB=

# Node's bundled DNS resolver refuses the SRV lookup that mongodb+srv:// needs
# on some Windows/router setups. Set a public resolver if `querySrv ECONNREFUSED`
# shows up locally. Leave empty on Linux and on Render.
DNS_SERVERS=

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_EXPIRES_IN_DAYS=30

# Default password assigned to accounts created through the app's Create User
# flow. The new user should change it on first sign-in.
SEED_PASSWORD=demo@1234

# The only company domain an account may be created under. Anything else is
# rejected with a validation message.
ALLOWED_EMAIL_DOMAIN=@superaip.com

# The single account `npm run db:seed` creates, so somebody can sign in and use
# the Create User flow. There are no other pre-defined users — employees,
# managers and admins are all created from the app.
BOOTSTRAP_ADMIN_NAME=System Administrator
BOOTSTRAP_ADMIN_EMAIL=admin@superaip.com
BOOTSTRAP_ADMIN_PASSWORD=

# Sign-in attempts per IP per 15 minutes.
AUTH_RATE_LIMIT=50
