# Server
PORT=4000
NODE_ENV=development
API_PREFIX=/api/v1

# MongoDB — Atlas connection string (database name goes in the path)
MONGODB_URI=mongodb+srv://chandak_db_user:chanda123456@cluster0.t9mkojm.mongodb.net/hrmh?retryWrites=true&w=majority&appName=Cluster0
# Optional: override the database from the URI path
MONGODB_DB=

# Node's bundled DNS resolver refuses the SRV lookup that mongodb+srv:// needs
# on some Windows/router setups. Set a public resolver if `querySrv ECONNREFUSED`
# shows up locally. Leave empty on Linux and on Render.
DNS_SERVERS=

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_EXPIRES_IN_DAYS=30

# Demo password used by the seeder for every employee
SEED_PASSWORD=demo@1234
