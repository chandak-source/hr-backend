{
  "name": "chanda-hr-server",
  "version": "1.0.0",
  "private": true,
  "description": "REST API for the Chanda HR (Employee Self Service) Flutter app",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "db:reset": "node src/db/migrate.js --fresh && node src/db/seed.js",
    "smoke": "node scripts/smoke.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "mysql2": "^3.15.4",
    "zod": "^4.1.12"
  },
  "engines": {
    "node": ">=20"
  }
}
